import { useEffect, useRef, useState, useCallback, lazy, Suspense } from 'react';
import { motion, useScroll, useTransform, useInView } from 'framer-motion';
import {
  ArrowRight, Check, Sparkles,
} from 'lucide-react';
import { Button } from '@/components/ui/button';
import { Navbar } from '@/components/Navbar';
import { Footer } from '@/components/Footer';
import { KnowledgeNetwork } from '@/components/KnowledgeNetwork';
import { SearchBar } from '@/components/SearchBar';
import { KnowledgeGraph } from '@/components/KnowledgeGraph';
import { animateEngine } from '@/components/KnowledgeEngine';
import { useNavigate } from 'react-router';
import { features } from '@/data/mock-data';

// Lazy-load the heavy 3D engine canvas — saves ~200KB from initial bundle
const LazyEngineCanvasLoader = lazy(() =>
  import('@/components/engine3d/EngineCanvasLoader').then((m) => ({
    default: m.EngineCanvasLoader,
  }))
);

/* ------------------------------------------------------------------ */
/*  FadeInSection wrapper (unchanged)                                  */
/* ------------------------------------------------------------------ */
function FadeInSection({ children, className }: { children: React.ReactNode; className?: string }) {
  const ref = useRef(null);
  const isInView = useInView(ref, { once: true, margin: '-100px' });

  return (
    <motion.div
      ref={ref}
      initial={{ opacity: 0, y: 40 }}
      animate={isInView ? { opacity: 1, y: 0 } : {}}
      transition={{ duration: 0.7, ease: [0.22, 1, 0.36, 1] }}
      className={className}
    >
      {children}
    </motion.div>
  );
}

/* ------------------------------------------------------------------ */
/*  ScrollStory — anime.js-powered scroll-reveal section               */
/* ------------------------------------------------------------------ */
function ScrollStory({
  children,
  className,
  onAnimate,
}: {
  children: React.ReactNode;
  className?: string;
  onAnimate?: (container: HTMLElement) => void;
}) {
  const ref = useRef<HTMLDivElement>(null);
  const [hasAnimated, setHasAnimated] = useState(false);

  useEffect(() => {
    const el = ref.current;
    if (!el || !onAnimate || hasAnimated) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasAnimated) {
            setHasAnimated(true);
            onAnimate(el);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.2 },
    );

    observer.observe(el);
    return () => observer.disconnect();
  }, [onAnimate, hasAnimated]);

  return (
    <div ref={ref} className={className}>
      {children}
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  Engine scroll animations                                           */
/* ------------------------------------------------------------------ */
const animateEngineSection = (container: HTMLElement) => {
  animateEngine(container);
};

/* ------------------------------------------------------------------ */
/*  Main Landing Component                                             */
/* ------------------------------------------------------------------ */
export default function Landing() {
  const navigate = useNavigate();
  const { scrollYProgress } = useScroll();
  const heroOpacity = useTransform(scrollYProgress, [0, 0.15], [1, 0]);
  const heroY = useTransform(scrollYProgress, [0, 0.15], [0, -50]);
  const graphRef = useRef(null);
  const graphInView = useInView(graphRef, { once: true, margin: '-100px' });

  // Get Started explosion state
  const [isExploding, setIsExploding] = useState(false);
  const [showZoomOverlay, setShowZoomOverlay] = useState(false);
  const [navigating, setNavigating] = useState(false);
  const [searchInput, setSearchInput] = useState('');
  const heroRef = useRef<HTMLDivElement>(null);
  const networkRef = useRef<HTMLDivElement>(null);

  const handleGetStarted = useCallback(() => {
    if (navigating) return;
    setNavigating(true);

    // Step 1: Trigger graph explosion
    setIsExploding(true);

    // Step 2: Sign in as guest (directly via localStorage)
    const guestUser = { name: 'Guest User', email: 'guest@cortex.explore' };
    localStorage.setItem('cortex_auth', 'true');
    localStorage.setItem('cortex_user', JSON.stringify(guestUser));

    // Step 3: Wait for explosion, then zoom
    setTimeout(() => {
      setShowZoomOverlay(true);

      // Step 4: Zoom travels into the graph — navigate to dashboard
      setTimeout(() => {
        navigate('/dashboard');
      }, 1500);
    }, 2500);
  }, [navigate, navigating]);

  const handleExplosionComplete = useCallback(() => {
    // Explosion finished — zoom overlay triggers via the timeout
  }, []);

  return (
    <div className="min-h-screen bg-[#0a0a0a] text-white overflow-x-hidden">
      <Navbar />

      {/* ===== ZOOM OVERLAY for Get Started transition ===== */}
      {showZoomOverlay && (
        <motion.div
          initial={{ opacity: 0, scale: 1 }}
          animate={{ opacity: 1, scale: 1.6 }}
          transition={{ duration: 1.4, ease: [0.22, 1, 0.36, 1] }}
          className="fixed inset-0 z-[100] bg-black pointer-events-none"
          style={{ filter: 'blur(6px)' }}
        />
      )}

      {/* ===== HERO ===== */}
      <motion.section
        ref={heroRef}
        style={{ opacity: showZoomOverlay ? 0 : heroOpacity, y: heroY }}
        className="relative min-h-screen flex flex-col items-center justify-center px-4 pt-24 pb-16"
      >
        <div className="max-w-6xl mx-auto w-full grid lg:grid-cols-2 gap-12 items-center">
          {/* Left side - Text */}
          <div className="flex flex-col gap-6">
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6, delay: 0.1, ease: [0.22, 1, 0.36, 1] }}
            >
              <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-[11px] font-medium text-white/60 tracking-wide uppercase">
                <Sparkles className="w-3 h-3" strokeWidth={1.5} />
                A Better Way To Search
              </span>
            </motion.div>

            <motion.h1
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6, delay: 0.2, ease: [0.22, 1, 0.36, 1] }}
              className="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-semibold tracking-tight leading-[1.08] text-white"
            >
              Search{' '}
              <span className="relative inline-block">
                Differently.
                <motion.span
                  className="absolute -bottom-1 left-0 right-0 h-[2px] bg-white/20"
                  initial={{ scaleX: 0 }}
                  animate={{ scaleX: 1 }}
                  transition={{ duration: 0.8, delay: 0.8, ease: [0.22, 1, 0.36, 1] }}
                />
              </span>
            </motion.h1>

            <motion.p
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6, delay: 0.3, ease: [0.22, 1, 0.36, 1] }}
              className="text-base sm:text-lg text-white/50 max-w-md leading-relaxed font-[350]"
            >
              Cortex transforms scattered information into interactive knowledge graphs instead of endless webpages.
            </motion.p>

            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6, delay: 0.4, ease: [0.22, 1, 0.36, 1] }}
              className="flex flex-col gap-5 mt-2"
            >
              <SearchBar
                placeholder="What do you want to understand?"
                large
                value={searchInput}
                onChange={setSearchInput}
                onSubmit={handleGetStarted}
              />

              <div className="flex items-center gap-3">
                <Button
                  size="lg"
                  className="bg-white text-black hover:bg-neutral-200 rounded-xl h-11 px-6 text-sm shadow-sm transition-all duration-300 active:scale-[0.97]"
                  onClick={handleGetStarted}
                >
                  Get Started
                  <ArrowRight className="w-4 h-4 ml-1" strokeWidth={1.5} />
                </Button>
                <Button
                  variant="outline"
                  size="lg"
                  className="rounded-xl h-11 px-6 text-sm border-white/20 text-white/50 hover:text-white hover:border-white/40"
                  onClick={() => navigate('/auth')}
                >
                  Learn more
                </Button>
              </div>
            </motion.div>
          </div>

          {/* Right side - Animated Knowledge Network (infinite feel) */}
          <motion.div
            ref={networkRef}
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ duration: 0.8, delay: 0.2, ease: [0.22, 1, 0.36, 1] }}
            className="relative w-full h-[400px] sm:h-[450px] lg:h-[520px]"
          >
            <div className="absolute inset-0 -m-12">
              <KnowledgeNetwork
                className="absolute inset-0 w-full h-full"
                isExploding={isExploding}
                onExplosionComplete={handleExplosionComplete}
              />
            </div>
          </motion.div>
        </div>

        {/* Scroll indicator */}
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          transition={{ delay: 1.5 }}
          className="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 z-10"
        >
          <motion.div
            animate={{ y: [0, 6, 0] }}
            transition={{ duration: 2, repeat: Infinity, ease: 'easeInOut' }}
            className="w-5 h-8 rounded-full border border-white/20 flex items-start justify-center pt-1.5"
          >
            <motion.div className="w-1 h-2 rounded-full bg-white/30" />
          </motion.div>
        </motion.div>
      </motion.section>

      {/* =============================================================== */}
      {/*  INSIDE CORTEX — Cinematic pinned 3D engine reveal              */}
      {/*  EngineCanvasLoader handles GSAP ScrollTrigger pinning          */}
      {/* =============================================================== */}
      <section className="relative">
        <div className="px-4 pb-8 sm:pb-12 text-center pointer-events-none">
          <h2 className="text-3xl sm:text-5xl font-semibold tracking-tight text-white mb-4">
            Inside Cortex
          </h2>
          <p className="text-sm sm:text-base text-white/40 font-[350] max-w-lg mx-auto">
            A precision knowledge engine that transforms raw information into structured understanding.
          </p>
        </div>

        {/* 3D racing engine canvas — lazy loaded, owns its own ScrollTrigger pinning */}
        <div className="w-full">
          <Suspense fallback={<div className="h-screen w-full" />}>
            <LazyEngineCanvasLoader />
          </Suspense>
        </div>
      </section>

      {/* =============================================================== */}
      {/*  EXISTING SECTIONS (adapted for black theme)                   */}
      {/* =============================================================== */}

      {/* ===== KNOWLEDGE GRAPH PREVIEW ===== */}
      <FadeInSection>
        <section ref={graphRef} className="px-4 py-24 sm:py-32 bg-white/[0.02]">
          <div className="max-w-6xl mx-auto">
            <div className="text-center mb-12">
              <h2 className="text-3xl sm:text-4xl font-semibold tracking-tight text-white">
                Interactive Knowledge Graph
              </h2>
              <p className="mt-4 text-white/50 max-w-lg mx-auto font-[350]">
                See how ideas connect. Drag nodes, explore relationships, and discover what you never knew you were looking for.
              </p>
            </div>

            <motion.div
              initial={{ opacity: 0, y: 40 }}
              animate={graphInView ? { opacity: 1, y: 0 } : {}}
              transition={{ duration: 0.8, delay: 0.2, ease: [0.22, 1, 0.36, 1] }}
              className="h-[500px] sm:h-[600px] rounded-2xl border border-white/[0.06] overflow-hidden bg-[#0a0a0a] shadow-lg"
            >
              <KnowledgeGraph interactive={true} />
            </motion.div>
          </div>
        </section>
      </FadeInSection>

      {/* ===== FEATURES ===== */}
      <FadeInSection>
        <section id="features" className="px-4 py-24 sm:py-32">
          <div className="max-w-6xl mx-auto">
            <div className="text-center mb-16">
              <h2 className="text-3xl sm:text-4xl font-semibold tracking-tight text-white">
                Everything you need to explore knowledge
              </h2>
              <p className="mt-4 text-white/50 max-w-md mx-auto font-[350]">
                Built for researchers, students, and the endlessly curious.
              </p>
            </div>

            <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {features.map((feature, i) => (
                <motion.div
                  key={feature.title}
                  initial={{ opacity: 0, y: 20 }}
                  whileInView={{ opacity: 1, y: 0 }}
                  viewport={{ once: true, margin: '-60px' }}
                  transition={{ duration: 0.4, delay: i * 0.04, ease: [0.22, 1, 0.36, 1] }}
                  className="group p-5 rounded-xl border border-white/10 hover:border-white/20 hover:bg-white/[0.03] transition-all duration-300"
                >
                  <div className="flex items-start gap-4">
                    <div className="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/20 transition-colors">
                      <Check className="w-4 h-4 text-white/50" strokeWidth={1.5} />
                    </div>
                    <div>
                      <h3 className="text-sm font-medium text-white mb-1">{feature.title}</h3>
                      <p className="text-xs text-white/50 leading-relaxed font-[350]">
                        {feature.description}
                      </p>
                    </div>
                  </div>
                </motion.div>
              ))}
            </div>
          </div>
        </section>
      </FadeInSection>

      {/* ===== BUILT FOR THINKERS ===== */}
      <FadeInSection>
        <section id="about" className="px-4 py-24 sm:py-32 bg-white/[0.02]">
          <div className="max-w-3xl mx-auto text-center">
            <motion.h2
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.6, ease: [0.22, 1, 0.36, 1] }}
              className="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.1] text-white"
            >
              Built for <span className="italic">thinkers</span>.
            </motion.h2>
            <motion.p
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.6, delay: 0.1, ease: [0.22, 1, 0.36, 1] }}
              className="mt-6 text-lg text-white/50 leading-relaxed font-[350] max-w-lg mx-auto"
            >
              Don't search websites. Explore knowledge.
            </motion.p>
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.6, delay: 0.2, ease: [0.22, 1, 0.36, 1] }}
              className="mt-8"
            >
              <Button
                size="lg"
                className="bg-white text-black hover:bg-neutral-200 rounded-xl h-12 px-8 text-sm shadow-sm"
                onClick={() => navigate('/auth')}
              >
                Start Exploring
                <ArrowRight className="w-4 h-4 ml-2" strokeWidth={1.5} />
              </Button>
            </motion.div>
          </div>
        </section>
      </FadeInSection>

      {/* ===== PRICING ===== */}
      <FadeInSection>
        <section id="pricing" className="px-4 py-24 sm:py-32">
          <div className="max-w-6xl mx-auto">
            <div className="max-w-xl mx-auto text-center mb-12">
              <h2 className="text-3xl sm:text-4xl font-semibold tracking-tight text-white">
                Simple pricing
              </h2>
              <p className="mt-4 text-white/50 font-[350]">
                Knowledge should be free. No paywalls, no credits, no surprises.
              </p>
            </div>

            <div className="max-w-sm mx-auto">
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true }}
                transition={{ duration: 0.5, ease: [0.22, 1, 0.36, 1] }}
                className="relative p-8 rounded-2xl border border-white/10 bg-white/[0.03] text-center"
              >
                <div className="text-5xl font-bold tracking-tight text-white">$0</div>
                <p className="text-sm text-white/50 mt-2 mb-6">Free forever</p>
                <ul className="text-left space-y-3 mb-8">
                  {['Unlimited searches', 'Full knowledge graph', 'AI chat with nodes', 'Source verification', 'No ads ever'].map((item) => (
                    <li key={item} className="flex items-center gap-3 text-sm text-white/50">
                      <Check className="w-4 h-4 text-white/40 shrink-0" strokeWidth={1.5} />
                      {item}
                    </li>
                  ))}
                </ul>
                <Button
                  className="w-full bg-white text-black hover:bg-neutral-200 rounded-xl h-11 text-sm"
                  onClick={() => navigate('/auth')}
                >
                  Get Started Free
                  <ArrowRight className="w-4 h-4 ml-1" strokeWidth={1.5} />
                </Button>
              </motion.div>
            </div>
          </div>
        </section>
      </FadeInSection>

      <Footer />
    </div>
  );
}
