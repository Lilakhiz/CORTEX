import { motion } from 'framer-motion';
import {
  ZoomIn,
  ZoomOut,
  Maximize2,
  Minimize2,
  Expand,
  Shrink,
  RefreshCw,
  RotateCcw,
} from 'lucide-react';
import { cn } from '@/lib/utils';

interface GraphToolbarProps {
  onZoomIn: () => void;
  onZoomOut: () => void;
}

export function GraphToolbar({
  onZoomIn,
  onZoomOut,
}): GraphToolbarProps {
  const buttons = [
    { icon: ZoomIn, label: 'Zoom In', action: onZoomIn },
    { icon: ZoomOut, label: 'Zoom Out', action: onZoomOut },
  ];

  return (
    <motion.div
      initial={{ opacity: 0, y: -10 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.3, ease: [0.22, 1, 0.36, 1] }}
      className="flex items-center gap-0.5 p-1 rounded-xl border border-black/10 dark:border-white/10 bg-white/80 dark:bg-neutral-900/80 backdrop-blur-lg shadow-sm"
    >
      {buttons.map((btn, i) => (
        <button
          key={btn.label}
          onClick={btn.action}
          className={cn(
            'flex items-center justify-center w-8 h-8 rounded-lg',
            'text-neutral-500 dark:text-neutral-400',
            'hover:text-black dark:hover:text-white',
            'hover:bg-black/5 dark:hover:bg-white/10',
            'transition-all duration-200',
            'active:scale-95',
          )}
          title={btn.label}
        >
          <btn.icon className="w-3.5 h-3.5" strokeWidth={1.5} />
        </button>
      ))}

      {/* Separator */}
      <div className="w-px h-5 bg-black/5 dark:bg-white/10 mx-0.5" />

      {buttons.length > 0 && (
        <span className="hidden sm:block text-[10px] text-neutral-400 dark:text-neutral-500 px-1.5 font-medium select-none">
          GRAPH
        </span>
      )}
    </motion.div>
  );
}
